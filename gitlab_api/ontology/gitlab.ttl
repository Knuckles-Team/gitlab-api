@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GitLab DevOps ontology — projects, code review, and CI/CD delivery. All classes and
# properties live in the shared `:` (kg#) namespace; only the owl:Ontology node gets the
# per-package IRI. Backs the gitlab-api MCP tool surface (gitlab_projects / gitlab_merge_requests
# / gitlab_pipelines / gitlab_issues / …).

# Shared concepts owned by the epistemic-graph ontology and referenced here, never redeclared:
# Commit, Branch, Release, Runner, Milestone, PipelineRun. Only the GitLab-specific subclasses and properties are declared in this pack.

:GitLabGroup a owl:Class ;
    rdfs:subClassOf :IdentityGroup ;
    rdfs:label "GitLab Group" ;
    rdfs:comment "A namespace that owns projects and subgroups (gitlab_groups)." .

:Project a owl:Class ;
    rdfs:subClassOf :SoftwareProject ;
    rdfs:label "Project" ;
    rdfs:comment "A GitLab project / repository (gitlab_projects)." .

:MergeRequest a owl:Class .


:Pipeline a owl:Class ;
    rdfs:subClassOf :PipelineRun ;
    rdfs:label "Pipeline" ;
    rdfs:comment "A CI/CD pipeline run for a commit/ref (gitlab_pipelines)." .

:Job a owl:Class ;
    rdfs:label "Job" ;
    rdfs:comment "A single stage/job within a pipeline (gitlab_jobs)." .

:CheckRun a owl:Class ;
    rdfs:subClassOf :PipelineRun ;
    rdfs:label "Check Run" ;
    rdfs:comment """A single job/check within a PipelineRun (a GitLab pipeline job, ingested by
    gitlab_api.kg_ingest.ingest_pipeline_runs, id gitlab:checkrun:<project>:<pipeline>:<job>).
    Shares its class name with the twin github-agent producer.""" ;
    owl:equivalentClass :Job .

:Issue a owl:Class ;
    rdfs:subClassOf :WorkItem ;
    rdfs:label "Issue" ;
    rdfs:comment "A tracked work item or defect (gitlab_issues)." .

:Epic a owl:Class ;
    rdfs:subClassOf :WorkItem ;
    rdfs:label "Epic" ;
    rdfs:comment "A group-level container aggregating related issues (gitlab_epics)." .

# --- links (owl:ObjectProperty) ---

:belongsToProject a owl:ObjectProperty ;
    rdfs:label "belongs to project" ;
    rdfs:comment "Links a merge request, pipeline, issue, commit, or branch to its Project." ;
    rdfs:range :Project .

:partOfGroup a owl:ObjectProperty ;
    rdfs:label "part of group" ;
    rdfs:comment "Links a Project or Epic to its owning GitLabGroup." ;
    rdfs:domain :Project ;
    rdfs:range :GitLabGroup .

:targetsBranch a owl:ObjectProperty ;
    rdfs:label "targets branch" ;
    rdfs:comment "Links a MergeRequest to the Branch it merges into." ;
    rdfs:domain :MergeRequest ;
    rdfs:range :Branch .

:triggeredPipeline a owl:ObjectProperty ;
    rdfs:label "triggered pipeline" ;
    rdfs:comment "Links a Commit or MergeRequest to a Pipeline it started." ;
    rdfs:range :Pipeline .

:ranFor a owl:ObjectProperty ;
    rdfs:label "ran for" ;
    rdfs:comment """Links a PipelineRun to what it ran for — its Project, the Commit it built,
    and/or the MergeRequest it validated. Same predicate name as the twin github-agent producer
    (PipelineRun ranFor Repository/Commit/PullRequest), unifying GitLab CI/CD and GitHub Actions.""" ;
    rdfs:domain :PipelineRun .

:hasJob a owl:ObjectProperty ;
    rdfs:label "has job" ;
    rdfs:comment """Links a PipelineRun to a CheckRun (job/check) it contains. Same predicate name
    as the twin github-agent producer (PipelineRun hasJob CheckRun).""" ;
    rdfs:domain :Pipeline ;
    rdfs:range :Job .

:ranOnRunner a owl:ObjectProperty ;
    rdfs:label "ran on runner" ;
    rdfs:comment "Links a Job to the Runner that executed it." ;
    rdfs:domain :Job ;
    rdfs:range :Runner .

:closesIssue a owl:ObjectProperty ;
    rdfs:label "closes issue" ;
    rdfs:comment "Links a MergeRequest to an Issue it resolves." ;
    rdfs:domain :MergeRequest ;
    rdfs:range :Issue .

:hasMilestone a owl:ObjectProperty ;
    rdfs:label "has milestone" ;
    rdfs:comment "Links an Issue or MergeRequest to its Milestone." ;
    rdfs:range :Milestone .

:authoredBy a owl:ObjectProperty ;
    rdfs:label "authored by" ;
    rdfs:comment "Links a MergeRequest, Issue, or Commit to the Person who created it." ;
    rdfs:range :Person .

:projectOwnedBy a owl:ObjectProperty ;
    rdfs:label "project owned by" ;
    rdfs:comment "Links a Project to the Person who owns it (projects.owner, user-namespace projects)." ;
    rdfs:subPropertyOf :ownedBy ;
    rdfs:domain :Project ;
    rdfs:range :Person .

:issueAuthoredBy a owl:ObjectProperty ;
    rdfs:label "issue authored by" ;
    rdfs:comment "Links an Issue to the Person who opened it (issues.author)." ;
    rdfs:subPropertyOf :authoredBy ;
    rdfs:domain :Issue ;
    rdfs:range :Person .

:issueAssignedTo a owl:ObjectProperty ;
    rdfs:label "issue assigned to" ;
    rdfs:comment "Links an Issue to a Person it is assigned to (issues.assignees)." ;
    rdfs:domain :Issue ;
    rdfs:range :Person .

# --- fields (owl:DatatypeProperty) ---

:iid a owl:DatatypeProperty ;
    rdfs:label "internal id" ;
    rdfs:comment "Project-scoped internal id of a MergeRequest, Issue, or Epic (e.g. !42, #17)." ;
    rdfs:range xsd:string .

:webUrl a owl:DatatypeProperty ;
    rdfs:label "web url" ;
    rdfs:comment "Canonical GitLab web URL of the object." ;
    rdfs:range xsd:string .

:state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:comment "Lifecycle state (opened, closed, merged, locked)." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Issue :MergeRequest ) ] ;
    rdfs:range xsd:string .

:pipelineStatus a owl:DatatypeProperty ;
    rdfs:label "pipeline status" ;
    rdfs:comment "Result status of a Pipeline or Job (success, failed, running, canceled)." ;
    rdfs:range xsd:string .

:ref a owl:DatatypeProperty ;
    rdfs:label "ref" ;
    rdfs:comment "Git ref (branch or tag) a Pipeline or Release was built from." ;
    rdfs:range xsd:string .

:sha a owl:DatatypeProperty ;
    rdfs:label "sha" ;
    rdfs:comment "Full git commit SHA." ;
    rdfs:range xsd:string .

:triggerSource a owl:DatatypeProperty ;
    rdfs:label "trigger source" ;
    rdfs:comment "How a Pipeline or Job was triggered (push, web, schedule, api, merge_request_event, …). Named apart from the shared provenance `source` field." ;
    rdfs:range xsd:string .

:failureReason a owl:DatatypeProperty ;
    rdfs:label "failure reason" ;
    rdfs:comment "GitLab's classification of why a Job failed (e.g. script_failure, runner_system_failure)." ;
    rdfs:range xsd:string .

:duration a owl:DatatypeProperty ;
    rdfs:label "duration" ;
    rdfs:comment "Wall-clock duration of a Pipeline or Job run, in seconds." ;
    rdfs:range xsd:decimal .

:createdAt a owl:DatatypeProperty ;
    rdfs:label "created at" ;
    rdfs:comment "Timestamp an object was created." ;
    rdfs:range xsd:dateTime .

:startedAt a owl:DatatypeProperty ;
    rdfs:label "started at" ;
    rdfs:comment "Timestamp a Pipeline or Job started running." ;
    rdfs:range xsd:dateTime .

:finishedAt a owl:DatatypeProperty ;
    rdfs:label "finished at" ;
    rdfs:comment "Timestamp a Pipeline or Job finished running." ;
    rdfs:range xsd:dateTime .

:logUrl a owl:DatatypeProperty ;
    rdfs:label "log url" ;
    rdfs:comment "URL to the raw log output of a Job." ;
    rdfs:range xsd:string .

<http://knuckles.team/kg/gitlab> a owl:Ontology ;
    rdfs:label "GitLab DevOps Ontology" ;
    rdfs:comment """GitLab source-control and CI/CD delivery model — groups, projects,
    merge requests, pipelines, jobs, issues, epics, milestones, commits, branches,
    releases and runners, with their review and delivery relationships — federated into
    the agent-connector-sdk knowledge-graph hub.""" .
