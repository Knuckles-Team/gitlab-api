{
  "connector": "gitlab-mcp",
  "sources": [
    {
      "source_id": "projects",
      "record_type": "Project",
      "tools": [
        "gitlab_get_projects"
      ],
      "records_path": "data",
      "id_field": "id",
      "title_field": "path_with_namespace",
      "text_field": "description",
      "cursor_field": "last_activity_at",
      "incremental": true,
      "description": "GitLab projects visible to the configured token."
    },
    {
      "source_id": "issues",
      "record_type": "Issue",
      "tools": [
        "gitlab_get_issues"
      ],
      "records_path": "data",
      "id_field": "id",
      "title_field": "title",
      "text_field": "description",
      "cursor_field": "updated_at",
      "incremental": false,
      "arguments": {
        "state": "opened",
        "per_page": 50,
        "max_pages": 1
      },
      "description": "Open GitLab issues visible to the configured token (first 50)."
    }
  ]
}
