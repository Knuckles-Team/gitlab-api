@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/gitlab#> .

# Read contracts for the classes declared by gitlab.ttl.  The MCP tools expose
# both read and write actions, but these mappings are read-only query routes:
# callers select the listed get action through the operation's action envelope.
# The source classes stay in GitLab's ontology namespace.  No heuristic
# crosswalk to a hub class is asserted here.

:gitlabGroupAccess a ac:AccessContract ;
    ac:classIri :GitLabGroup ;
    ac:sourceId "gitlab-api" ;
    ac:entity "group" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "gitlab_groups" ;
    ac:parameter "action", "params_json" ;
    ac:pagination "page" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://GITLAB_TOKEN" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "medium" .

:gitlabGroupWebUrlBinding a ac:PropertyBinding ;
    ac:contract :gitlabGroupAccess ; ac:property :webUrl ; ac:field "web_url" .

